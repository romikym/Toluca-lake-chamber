# Toluca Lake Chamber — environment variables
# Copy to .env.local (or .env) and fill in. DATABASE_URL + AUTH_SECRET are required;
# the rest enable real services and have graceful fallbacks if omitted.

# --- Database (REQUIRED) — Supabase Postgres ---
# Supabase Dashboard → Connect → ORMs → Prisma gives both URLs ready to paste.
#   DATABASE_URL = POOLED (Supavisor, transaction mode, port 6543) — used at runtime/serverless
#   DIRECT_URL   = DIRECT  (port 5432) — used by `prisma db push` / migrations
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Auth (REQUIRED) ---
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET="replace-with-a-32+char-random-string"
AUTH_TRUST_HOST=true
# In production set this to your deployed URL:
# AUTH_URL="https://your-site.netlify.app"

# --- AI (Claude) — optional ---
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-3-5-haiku-latest

# --- Payments / Stripe — optional ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Email / Resend — optional ---
# RESEND_API_KEY=
# EMAIL_FROM="Toluca Lake Chamber <hello@tolucalakechamber.com>"

# --- Maps — optional (future) ---
# NEXT_PUBLIC_MAPBOX_TOKEN=
